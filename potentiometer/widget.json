{
  "cncjs_widget_version": "1.0",
  "id": "potentiometer",
  "name": "Potentiometer",
  "version": "1.2.0",
  "author": {
    "name": "Mark Dyer",
    "organization": "fireCNC",
    "display": "Mark Dyer @ fireCNC"
  },
  "description": "Tactile Feed Rate and Spindle RPM override dials with Makita RT0700C speed dial",
  "capabilities": [
    "native-settings",
    "changelog",
    "config-sync",
    "api-events"
  ],
  "entry": "index.html",
  "settings": "settings.html",
  "changelog": "CHANGELOG.md",
  "configFile": "config.json",
  "icon": "fa-sliders",
  "category": "Controls",
  "compatibility": {
    "controllers": [
      "Smoothie",
      "Grbl",
      "LinuxCNC",
      "TinyG"
    ],
    "minCncjs": "1.9.0"
  },
  "defaultHeight": 206,
  "header": {
    "showRefresh": true,
    "showSettings": true,
    "showCollapse": true,
    "showDropdown": true,
    "showFullscreen": false,
    "showFork": false,
    "showRemove": true,
    "hideHeader": false
  }
}