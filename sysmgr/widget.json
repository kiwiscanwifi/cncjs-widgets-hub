{
  "cncjs_widget_version": "1.0",
  "min_widgetmgr_version": "1.0.0",
  "id": "sysmgr",
  "name": "System Manager",
  "version": "1.1.0",
  "author": {
    "name": "Mark Dyer",
    "organization": "fireCNC",
    "display": "Mark Dyer @ fireCNC"
  },
  "description": "Host OS power management (reboot, shutdown, CNCjs restart, and sync) with active-cut interlock.",
  "capabilities": [
    "native-settings",
    "changelog"
  ],
  "entry": "index.html",
  "settings": "settings.html",
  "changelog": "CHANGELOG.md",
  "icon": "fa-server",
  "category": "System",
  "compatibility": {
    "controllers": [
      "LinuxCNC",
      "Smoothie",
      "Grbl"
    ],
    "minCncjs": "1.9.0"
  },
  "defaultHeight": 94
}