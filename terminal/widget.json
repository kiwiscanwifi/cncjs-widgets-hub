{
  "cncjs_widget_version": "1.0",
  "id": "terminal",
  "name": "Terminal",
  "version": "1.2.3",
  "author": {
    "name": "Mark Dyer",
    "organization": "fireCNC",
    "display": "Mark Dyer @ fireCNC"
  },
  "description": "Intelligent controller terminal with noise suppression, prefix blacklist, and full-screen diagnostics.",
  "capabilities": [
    "native-settings",
    "changelog",
    "config-sync",
    "traffic-suppression",
    "fullscreen-mode",
    "gcode-sender"
  ],
  "entry": "index.html",
  "settings": "settings.html",
  "changelog": "CHANGELOG.md",
  "configFile": "config.json",
  "icon": "fa-terminal",
  "category": "Diagnostics",
  "compatibility": {
    "controllers": [
      "Smoothie",
      "Grbl",
      "LinuxCNC",
      "TinyG",
      "Marlin"
    ],
    "minCncjs": "1.9.0"
  },
  "defaultHeight": 300,
  "header": {
    "showRefresh": true,
    "showSettings": true,
    "showCollapse": true,
    "showDropdown": true,
    "showFullscreen": true,
    "showFork": false,
    "showRemove": true,
    "hideHeader": false
  },
  "settingsUrl": "/widgets/terminal/settings.html",
  "settingsHeight": "450px"
}