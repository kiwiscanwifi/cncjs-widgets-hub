{
  "terminalHeight": 300,
  "bufferLimit": 2000,
  "fontSize": "11px",
  "fontFamily": "monospace",
  "theme": "amber",
  "showTimestamps": false,
  "timestampFormat": "none",
  "showLineNumbers": false,
  "autoUppercase": true,
  "retainInputOnSend": false,
  "historyDepth": 50,
  "confirmDangerousCommands": true,
  "audioAlertOnAlarm": true,
  "autoClearOnConnect": false,
  "commandLogging": {
    "enabled": true,
    "scope": "both",
    "logFile": "commands.log"
  },
  "visibility": {
    "search": {
      "widget": false,
      "fullscreen": true
    },
    "streamFilters": {
      "widget": false,
      "fullscreen": true
    },
    "macros": {
      "widget": true,
      "fullscreen": true
    },
    "commandBar": {
      "widget": true,
      "fullscreen": true
    },
    "clear": {
      "widget": true,
      "fullscreen": true
    },
    "copy": {
      "widget": true,
      "fullscreen": true
    },
    "paste": {
      "widget": true,
      "fullscreen": true
    },
    "fullscreen": {
      "widget": true,
      "fullscreen": false
    },
    "statusBadge": {
      "widget": true,
      "fullscreen": true
    },
    "downloadLog": {
      "widget": false,
      "fullscreen": true
    }
  },
  "suppressM119": true,
  "suppressStatus": true,
  "suppressOk": true,
  "suppressEmpty": true,
  "enableBlacklist": true,
  "blacklistPrefixes": [
    "M119",
    "X_min:",
    "Y_min:",
    "Z_min:",
    "pins-",
    "Probe:",
    "ok",
    "?",
    "<Idle",
    "<Run",
    "<Hold",
    "<Jog",
    "<Alarm",
    "<Door",
    "<Check",
    "<Home",
    "<Sleep",
    "echo:"
  ],
  "enableRegex": false,
  "customRegex": "",
  "macroButtons": [
    {
      "id": "m1",
      "cmd": "$$",
      "label": "$$ (Grbl Config)",
      "desc": "Inspect Grbl internal configuration",
      "color": "default",
      "customColor": ""
    },
    {
      "id": "m2",
      "cmd": "$I",
      "label": "$I (Build Info)",
      "desc": "View Grbl build version and info",
      "color": "default",
      "customColor": ""
    },
    {
      "id": "m3",
      "cmd": "?",
      "label": "? (Status)",
      "desc": "Query real-time controller state",
      "color": "primary",
      "customColor": ""
    },
    {
      "id": "m4",
      "cmd": "M119",
      "label": "M119 (Endstops)",
      "desc": "Check mechanical endstop status",
      "color": "warning",
      "customColor": ""
    },
    {
      "id": "m5",
      "cmd": "$#",
      "label": "$# (Work Offsets)",
      "desc": "Print coordinate systems and probe results",
      "color": "default",
      "customColor": ""
    },
    {
      "id": "m6",
      "cmd": "$G",
      "label": "$G (G-Code Parser)",
      "desc": "Inspect active modal parser states",
      "color": "default",
      "customColor": ""
    }
  ]
}