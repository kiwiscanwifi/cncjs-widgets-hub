{
  "cncjs_widget_version": "1.0",
  "min_widgetmgr_version": "1.0.0",
  "id": "widget-hub",
  "name": "Widget Hub",
  "version": "1.2.0",
  "author": {
    "name": "Mark Dyer",
    "organization": "fireCNC",
    "display": "Mark Dyer @ fireCNC"
  },
  "description": "CNCjs Custom Widget manager and catalog with server-side persistence, cross-device workspace sync, and version contracts.",
  "capabilities": [
    "changelog",
    "native-settings"
  ],
  "entry": "index.html",
  "changelog": "CHANGELOG.md",
  "icon": "fa-cubes",
  "category": "Hub",
  "compatibility": {
    "controllers": [
      "All"
    ],
    "minCncjs": "1.9.0"
  },
  "defaultHeight": 380,
  "header": {
    "showRefresh": true,
    "showSettings": true,
    "showCollapse": true,
    "showDropdown": true,
    "showFullscreen": true,
    "showFork": false,
    "showRemove": false,
    "hideHeader": false
  },
  "settings": "settings.html",
  "settingsUrl": "/widgets/widget-hub/settings.html",
  "settingsHeight": "560px"
}
